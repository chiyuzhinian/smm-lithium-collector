SMM_USERNAME=
SMM_PASSWORD=
SMM_LOGIN_URL=
SMM_TARGET_URL=
SMM_HEADLESS=true
SMM_TIMEOUT=30000

# MySQL 备份同步（可选，不填则不启用）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=smm_lithium
MYSQL_CHARSET=utf8mb4
MYSQL_CONNECT_TIMEOUT=10
MYSQL_SYNC_BATCH_SIZE=500
MYSQL_SYNC_MAX_RETRIES=3
MYSQL_SYNC_RETRY_INTERVAL=5
MYSQL_AUTO_CREATE_DATABASE=true
MYSQL_AUTO_SYNC_AFTER_COLLECTION=true

# 钉钉通知（可选，填写 Webhook URL 和 Secret 后自动推送日报）
DINGTALK_WEBHOOK=
DINGTALK_SECRET=

# 文件下载（钉钉日报下载链接拼此地址；填 nginx 公网入口，不带 8888 端口）
# 例如 FILE_HOST=http://101.37.235.13 （门户经 nginx 80 代理；8888 仅监听 127.0.0.1）
FILE_HOST=

# 门户账号库（可选，默认 /var/lib/smm-fileserver/auth.db，由 systemd StateDirectory 提供）
# 初始化账号：python scripts/init_auth.py（交互输入 huayou / admin 初始密码，首登强制改密）
# FILE_SERVER_AUTH_DB=/var/lib/smm-fileserver/auth.db

